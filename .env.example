# Mercado Libre OAuth App credentials
# 在 https://developers.mercadolibre.com.mx/devcenter 注册 App 后填入
ML_APP_ID=
ML_APP_SECRET=
ML_REDIRECT_URI=https://ml-sync.zeabur.app/oauth/callback

# Mercado Libre OAuth scopes
ML_SCOPES=offline_access read

# Bearer token for protecting our own endpoints (n8n calls)
SERVICE_AUTH_TOKEN=

# Feishu (聪哥1号 - lark-mcp/知识库/消息)
FEISHU_APP_ID=cli_a9f6ae86fce8dbd8
FEISHU_APP_SECRET=

# Feishu Bitable target table (M3 创建后填)
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# SQLite path (Zeabur volume mount or local)
SQLITE_PATH=/data/ml_sync.db
